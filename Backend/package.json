{
  "name": "qlyno-laboratory-api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "worker:hospital": "tsx src/workers/hospital-delivery.ts",
    "prebuild": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "6.7.0",
    "argon2": "0.41.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "4.22.2",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "hpp": "0.2.3",
    "jsonwebtoken": "9.0.2",
    "pino": "9.7.0",
    "pino-http": "10.4.0",
    "qlyno-monorepo": "file:..",
    "swagger-ui-express": "5.0.1",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/hpp": "0.2.6",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "22.15.3",
    "@types/supertest": "6.0.2",
    "@types/swagger-ui-express": "4.1.8",
    "jest": "29.7.0",
    "prisma": "^6.7.0",
    "supertest": "7.1.3",
    "ts-jest": "29.3.2",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/client@6.7.0": true,
    "argon2@0.41.1": true,
    "esbuild@0.25.12": true,
    "prisma@6.7.0": true,
    "@prisma/engines@6.7.0": true
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
