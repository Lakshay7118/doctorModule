// -----------------------------------------------------------------------------
// HMS / doctor-workplace schema merged for the shared Supabase database.
// Conflicting HMS enum names are prefixed with Hms* so the Qlyno Lab API keeps
// its existing generated enum names and behavior.
// -----------------------------------------------------------------------------

model appointments {
  id                  String               @id @db.Uuid
  patientId           String               @db.Uuid
  doctorId            String               @db.Uuid
  workplaceId         String               @db.Uuid
  locationId          String?              @db.Uuid
  roomId              String?              @db.Uuid
  scheduledAt         DateTime
  durationMinutes     Int                  @default(20)
  mode                AppointmentMode      @default(IN_PERSON)
  status              AppointmentStatus    @default(SCHEDULED)
  reason              String?
  checkedInAt         DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime
  doctor_profiles     doctor_profiles      @relation(fields: [doctorId], references: [id])
  workplace_locations workplace_locations? @relation(fields: [locationId], references: [id])
  patients            patients             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic_rooms        clinic_rooms?        @relation(fields: [roomId], references: [id])
  workplaces          workplaces           @relation(fields: [workplaceId], references: [id])
  billing_invoices    billing_invoices?
  encounters          encounters[]
  tasks               tasks[]

  @@index([doctorId, scheduledAt])
  @@index([patientId])
  @@index([roomId, scheduledAt])
  @@index([workplaceId, scheduledAt])
}

model audit_events {
  id            String         @id @db.Uuid
  actorUserId   String?        @db.Uuid
  action        String
  entityType    String
  entityId      String?
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime       @default(now())
  user_accounts user_accounts? @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}

model billing_invoices {
  idempotencyKey String?
  requestHash    String?
  finalizedAt    DateTime?
  lines          HospitalInvoiceLine[]
  refunds        HospitalRefund[]
  claims         InsuranceClaim[]
  id             String                @id @db.Uuid
  invoiceNumber  String                @unique
  patientId      String                @db.Uuid
  workplaceId    String                @db.Uuid
  appointmentId  String?               @unique @db.Uuid
  status         PaymentStatus         @default(UNPAID)
  subtotal       Decimal               @default(0) @db.Decimal(10, 2)
  discount       Decimal               @default(0) @db.Decimal(10, 2)
  tax            Decimal               @default(0) @db.Decimal(10, 2)
  total          Decimal               @default(0) @db.Decimal(10, 2)
  notes          String?
  issuedAt       DateTime              @default(now())
  createdAt      DateTime              @default(now())
  updatedAt      DateTime
  appointments   appointments?         @relation(fields: [appointmentId], references: [id])
  patients       patients              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  workplaces     workplaces            @relation(fields: [workplaceId], references: [id])
  payment_txns   payment_txns[]

  @@unique([workplaceId, idempotencyKey])
  @@index([patientId, issuedAt])
  @@index([workplaceId, status])
}

model clinic_rooms {
  hmsSurgeries HospitalSurgery[]

  id                  String               @id @db.Uuid
  workplaceId         String               @db.Uuid
  locationId          String?              @db.Uuid
  name                String
  roomType            String               @default("Consultation")
  status              RoomStatus           @default(ACTIVE)
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime
  appointments        appointments[]
  workplace_locations workplace_locations? @relation(fields: [locationId], references: [id])
  workplaces          workplaces           @relation(fields: [workplaceId], references: [id], onDelete: Cascade)

  @@unique([workplaceId, name])
  @@index([locationId])
}

model clinic_service_doctors {
  id              String          @id @db.Uuid
  serviceId       String          @db.Uuid
  doctorId        String          @db.Uuid
  fee             Decimal?        @db.Decimal(10, 2)
  createdAt       DateTime        @default(now())
  doctor_profiles doctor_profiles @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic_services clinic_services @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, doctorId])
  @@index([doctorId])
}

model clinic_services {
  labMappings            HospitalLabService[]
  id                     String                   @id @db.Uuid
  workplaceId            String                   @db.Uuid
  name                   String
  description            String?
  durationMinutes        Int                      @default(20)
  price                  Decimal?                 @db.Decimal(10, 2)
  isActive               Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  clinic_service_doctors clinic_service_doctors[]
  workplaces             workplaces               @relation(fields: [workplaceId], references: [id], onDelete: Cascade)

  @@unique([workplaceId, name])
  @@index([workplaceId, isActive])
}

model conversation_participants {
  id              String        @id @db.Uuid
  conversationId  String        @db.Uuid
  displayName     String
  participantType String
  userAccountId   String?       @db.Uuid
  lastReadAt      DateTime?
  createdAt       DateTime      @default(now())
  conversations   conversations @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model conversations {
  id                        String                      @id @db.Uuid
  type                      ConversationType
  workplaceId               String?                     @db.Uuid
  patientId                 String?                     @db.Uuid
  referralId                String?                     @db.Uuid
  title                     String?
